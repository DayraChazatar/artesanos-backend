# Copia este archivo como ".env" (sin el ".example") y llena los valores
# reales. El ".env" real NUNCA se sube a git (ya está en .gitignore) — cada
# quien que corra el proyecto (local, otra desarrolladora, o el servidor de
# producción) necesita su propia copia con sus propios valores.

# ── Django ────────────────────────────────────────────────────────────────
# Clave secreta de Django. En local puedes dejarla vacía (se genera una
# aleatoria automáticamente); en producción (DEBUG=False) es OBLIGATORIA.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Base de datos (Supabase/PostgreSQL) ──────────────────────────────────
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ── Supabase Storage (fotos de productos y de perfil) ────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Correo saliente (recuperación de contraseña) ─────────────────────────
# Si se dejan vacías, el correo se imprime en la consola del backend en vez
# de enviarse de verdad (útil para desarrollo/pruebas).
FRONTEND_URL=http://localhost:5173
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=

# ── Login con Google ──────────────────────────────────────────────────────
# El Client ID de Google no es secreto (es público por diseño), pero se deja
# configurable por si cambian de proyecto en Google Cloud Console.
GOOGLE_CLIENT_ID=

# ── Wompi (pagos) ─────────────────────────────────────────────────────────
# Estos dos SÍ son secretos — se consiguen en el dashboard de Wompi
# (comercios.wompi.co), sección de la tienda. Hay un juego de valores para
# "modo pruebas" y otro para "modo producción"; no se deben mezclar.
# La llave pública (pub_test_.../pub_prod_...) va en el .env del FRONTEND,
# no aquí — ver Artesanos-Frontend/.env.example.
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
